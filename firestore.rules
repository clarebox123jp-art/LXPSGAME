rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ★ v5.336.0(2026-11-03・老師「甲,匿名登入只在搶答擂台,不影響任何原有遊戲內的資料庫和存檔」)
    //   搶答擂台免登入用 Firebase「匿名登入」。為了不讓匿名身分碰到任何原有資料,
    //   本檔所有原本寫 request.auth != null 的地方一律改成 isRealUser()(＝有登入且不是匿名);
    //   只有搶答擂台房間 liveQuizRooms/{pin}(含 players/answers/powerups/private)、liveQuizBoard 讀取
    //   與 lqAnswerOk / lqPowerOk 保留 request.auth != null ⇒ 匿名身分只能參加搶答擂台這一場。
    function isRealUser() {
      return request.auth != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // ★ v6220 — 管理員白名單抽成函式(同步 index.html 的 _devEmails)
    function isAdmin() {
      return isRealUser()
          && request.auth.token.email_verified == true
          && request.auth.token.email in [
               'clarebox123@gmail.com',
               'clarebox123@lsps.tp.edu.tw',
               'asemia@gmail.com'
             ];
    }

    // ★ v3.5.0 — 停權欄位保護函式
    //   玩家自己不能寫 _suspended 相關欄位,否則被停權的玩家自己改回 false 就能繼續登入
    //   這 6 個欄位只有管理員可以動
    function isWritingSuspendFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['_suspended', '_suspendedAt', '_suspendedBy',
                      '_suspendReason', '_unsuspendedAt', '_unsuspendedBy']);
    }

    // ★ v3.5.67(2026-05-24) — 「小博士獎勵結算者」跨玩家寫入守門
    //   情境:小明的本機觸發 trySettleLastWeek() → 需要把獎勵寫到小華、小美等
    //          上榜玩家的 players/{小華}.weeklyQuizPendingAward
    //   安全考量:
    //     - 只允許「修改 weeklyQuizPendingAward 一個欄位」,其他欄位完全不能動
    //     - 不能新增其他欄位 → 用 hasOnly 嚴格判定
    //     - 因為 hasOnly 是 affectedKeys 的全包約束,小明不可能在同一次寫入
    //       同時改 _suspended / coins / 任何其他欄位
    function isWritingOnlyWeeklyQuizAward() {
      return request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['weeklyQuizPendingAward']);
    }

    // ★ v3.13.5(2026-05-31) — 「世界 BOSS 排名獎勵結算者」跨玩家寫入守門
    //   情境:BOSS 倒下後隔天 08:00,第一個登入玩家(小明)觸發
    //          _wbSettle.trySettle() → 需要把排名獎勵寫到隊伍中其他玩家
    //          (小華、小美、阿力)的 players/{uid}.wbPendingAward
    //   安全考量:
    //     - 同 weeklyQuizPendingAward 設計:只允許改 wbPendingAward 一個欄位
    //     - 玩家無法藉此改別人的 coins / heroLevels / _suspended 等
    //     - 結算當下會讀「GM 修正後的最終排行榜」(stats/global.worldBossLeaderboard),
    //       所以即使惡意玩家想假造寫入,內容也必須來自雲端權威排行榜
    function isWritingOnlyWbPendingAward() {
      return request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['wbPendingAward']);
    }

    // ★ v5.317.0 ⚡ 搶答擂台的共用函式(規則本體在檔尾「搶答擂台」區塊;放這裡是因為 gmClassRewards 也要用)
    function isLqHost() {
      return isAdmin()
          || (isRealUser()
              && request.auth.token.email_verified == true
              && exists(/databases/$(database)/documents/liveQuizHosts/$(request.auth.token.email.lower())));
    }
    function lqRoom(pin) {
      return get(/databases/$(database)/documents/liveQuizRooms/$(pin)).data;
    }
    function lqIsRoomHost(pin) {
      return isAdmin()
          || (isLqHost() && lqRoom(pin).meta.hostUid == request.auth.uid);
    }
    function lqPlayerOk(pin) {
      return exists(/databases/$(database)/documents/liveQuizRooms/$(pin)/players/$(request.auth.uid))
          && get(/databases/$(database)/documents/liveQuizRooms/$(pin)/players/$(request.auth.uid)).data.kicked == false;
    }
    // ★ v5.323.0(全班 27 人連線穩定):作答截止寬限 3 → 6 秒。全班同時送出時網路會塞車,晚幾秒才到雲端的答案不再被擋;
    //   主持台時間到後最多多等 4.5 秒、公布時把狀態切成 reveal 就一律拒收,所以寬限再大也不會讓人「看完答案才作答」。
    function lqAnswerOk(pin, aid) {
      let d = request.resource.data;
      let room = lqRoom(pin);
      return request.auth != null
          && aid == request.auth.uid + '_' + string(d.q)
          && d.uid == request.auth.uid
          && d.keys().hasOnly(['uid', 'q', 'c', 'at', 'ms'])
          && d.q is int
          && d.c is int && d.c >= 0 && d.c <= 3
          && d.ms is number
          && d.at == request.time
          && room.meta.status == 'question'
          && room.current.qIndex == d.q
          && request.time < room.current.startAt + duration.value(room.current.timeLimit + 6, 's')
          && lqPlayerOk(pin);
    }
    function lqPowerOk(pin, pid) {
      let d = request.resource.data;
      let room = lqRoom(pin);
      return request.auth != null
          && d.kind in ['cut', 'hint']
          && pid == request.auth.uid + '_' + d.kind
          && d.uid == request.auth.uid
          && d.keys().hasOnly(['uid', 'kind', 'q', 'at'])
          && d.at == request.time
          && room.meta.status == 'question'
          && room.current.qIndex == d.q
          && lqPlayerOk(pin);
    }
    // 主持人頒獎:只能照固定三級表、只能發給這一場的參加者、每人每場一筆(文件 id 固定)
    // ★ v5.318.0(老師 21:56)三級表加命星 cstStars(與 live_quiz.js TIERS 逐字一致,含順序;改一邊一定要同步改另一邊)
    function lqHostRewardOk(uid, rewardId) {
      let d = request.resource.data;
      let room = lqRoom(d.lq);
      return isLqHost()
          && d.lq is string
          && room.meta.hostUid == request.auth.uid
          && room.meta.status == 'ended'
          && rewardId == 'lq_' + d.lq + '_' + string(room.meta.createdAt)
          && exists(/databases/$(database)/documents/liveQuizRooms/$(d.lq)/players/$(uid))
          && d.uid == uid
          && d.enabled == true
          && d.keys().hasOnly(['uid', 'label', 'email', 'reward', 'itemsLabel', 'merit', 'by', 'at', 'enabled', 'lq'])
          && (d.reward == {'coins': 100000, 'coinsMode': 'add', 'backpack': {'summon_crystal': 10, 'hero_exp_book_premium': 5},
                           'cstStars': [{'k': '#pick_SSR', 'n': 1}, {'k': '#pick_SR', 'n': 1}]}
              || d.reward == {'coins': 60000, 'coinsMode': 'add', 'backpack': {'summon_crystal': 6, 'hero_exp_book_premium': 3},
                              'cstStars': [{'k': '#void_SSR', 'n': 2}, {'k': '#void_SR', 'n': 2}]}
              || d.reward == {'coins': 30000, 'coinsMode': 'add', 'backpack': {'summon_crystal': 3, 'hero_exp_book_premium': 1},
                              'cstStars': [{'k': '#void_SSR', 'n': 1}, {'k': '#void_SR', 'n': 1}]});
    }

    // ════════════════════════════════════════════════════════════════
    // ★ v3.13.7(2026-05-31) — 世界 BOSS 挑戰入場券系統 Rules 註記
    // ────────────────────────────────────────────────────────────────
    // 設計:
    //   - 玩家自己的 useTicket() / grantDailyTickets():寫自己 doc
    //     → 走「玩家自己 + 不寫停權欄位」既有路徑,無需新增規則
    //   - GM grantTicketByUid / clearTicketByUid:GM 寫別人 doc
    //     → 走 isAdmin() 全權路徑,無需新增規則
    //
    // 影響欄位(玩家自己會寫,但都不在停權保護清單,自動 OK):
    //   - playerBackpack(子欄位 wb_entry_ticket)
    //   - playerBackpack_s
    //   - wbDailyCount(count -1,useTicket 用)
    //   - wbNextBumpFromTicket(useTicket 設 true,bumpDailyCount 消耗時設 false)
    //   - wbTicketLastGrantDateStr(grantDailyTickets 同日守門)
    //
    // ⚠ 結論:本系統不需新增 rules 條款,既有 update 規則已涵蓋。
    //         此區塊僅作文件註記用,提醒未來維護者。
    // ════════════════════════════════════════════════════════════════

    // ════════════════════════════════════════════════════════════════
    // ★ v4.7.0(2026-07-04) — 寵物馴養全系統(v3.37.0~v4.7.0)Rules 註記
    // ────────────────────────────────────────────────────────────────
    // 設計(與 v3.13.7 入場券同型:全走既有路徑,不需新增條款):
    //   - 寵物資料全在玩家自己 doc 內,走既有規則自動涵蓋:
    //       tamedPets / tamedPets_s(馴養寵物本體:Lv/EXP/好感/跟隨)
    //       _petTameHistory / _petTameHistory_s(馴養帳本 200 筆,每筆帶
    //         src 來源 + uid 前12碼 → GM 污染稽查用)
    //       petHouseSlots(_s) / petHouseDaily(_s)(小屋入住/當日互動)
    //       petsEverCollected(圖鑑收錄)
    //       medalStats.petFeedOk / petPat / petPlayWin(互動計數,v4.6.0)
    //     → 位置:players/{uid} 主檔 + players/{uid}/saves/{slot} 雙槽,
    //       「玩家自己 + 不寫停權欄位」與 saves 既有規則已涵蓋。
    //   - GM 全站開關:gameConfig/petSystemSwitch → gameConfig 既有規則
    //     (寫限 isAdmin、登入者可讀)已涵蓋,免新增。
    //   - 寵物召喚卷帳本:pet_summon_ticket 領用紀錄寫入 ticketLedger/{uid}
    //     (v3.17.6 既有條款)→ GM「🐾 寵物紀錄」彈窗讀取佐證用。
    //   - GM「🐾 寵物紀錄」查詢(v4.7.0):isAdmin 讀 players 主檔 +
    //     ticketLedger get → 既有 isAdmin 路徑,免新增。
    //   - GM「🎁 指定補發寵物」(v4.7.0):isAdmin 寫 players 主檔 +
    //     saves/live·safe + 寄 pendingAdminNotifications 登入彈窗
    //     → 全部既有 isAdmin 路徑,免新增。
    //
    // ⚠ 結論:寵物系統 v3.37.0 ~ v4.7.0 零新增 rules 條款,
    //         此區塊僅作文件註記。部署本檔即完整支援寵物系統
    //         (含 GM 寵物紀錄/補發與寵物券雲端帳本)。
    // ════════════════════════════════════════════════════════════════

    // 玩家資料: 自己可讀寫,其他人只能讀(為了好友功能)
    // ★ v3.5.0 — 玩家自己寫入時不可動到「停權」相關欄位(那些只有管理員能寫)
    // ★ v3.5.67 — 任何登入玩家可寫別人的 weeklyQuizPendingAward(供小博士結算者用)
    // ★ v3.13.5 — 任何登入玩家可寫別人的 wbPendingAward(供世界 BOSS 結算者用)
    // ★ v3.13.7 — 入場券系統的玩家自寫(useTicket/grantDailyTickets)走玩家自己路徑;
    //              GM 補發/清空走 isAdmin 路徑,均已自動涵蓋,無需新增條款
    match /players/{uid} {
      allow read: if isRealUser();
      // create 時還沒有 resource(舊資料),直接放行(玩家自己 + 管理員)
      allow create: if (isRealUser() && request.auth.uid == uid)
                    || isAdmin();
      // update 時:
      //   管理員 → 全權
      //   玩家自己 → 除「停權欄位」之外可改
      //   其他登入玩家 → 只能改「weeklyQuizPendingAward」或「wbPendingAward」一個欄位
      //                  且不能動到停權欄位(雙重保險,鐵律 1.70)
      allow update: if isAdmin()
                    || (isRealUser()
                        && request.auth.uid == uid
                        && !isWritingSuspendFields())
                    || (isRealUser()
                        && request.auth.uid != uid
                        && isWritingOnlyWeeklyQuizAward()
                        && !isWritingSuspendFields())
                    || (isRealUser()
                        && request.auth.uid != uid
                        && isWritingOnlyWbPendingAward()
                        && !isWritingSuspendFields());
      // delete:只有管理員可刪
      allow delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════
    // ★ v3.12.0(2026-05-29)新增 — 好友送禮系統 pendingGifts 子集合
    // ★ v3.12.2(2026-05-30)補強 — 加 ts 偽造防護 + 五欄位個別型別檢查
    // ────────────────────────────────────────────────────────────────
    // 情境:
    //   小明送禮給小華 → 小明的客戶端寫一筆到
    //   players/{小華 uid}/pendingGifts/{auto-id}
    //   小華下次登入,_giftClaimPendingGifts 讀取 + 領取 + 刪除
    //
    // 規則設計(v3.12.2 強化版):
    //   create: 任何登入玩家可寫別人的 pendingGift,但限制:
    //           ① auth.uid != uid(不能送自己,防自肥)
    //           ② request.resource.data.from == auth.uid(from 必須是自己,防偽造)
    //           ③ hasOnly([5 欄位])(只能寫白名單欄位,防擴充攻擊)
    //           ★ v3.12.2 ④ 五個欄位個別型別檢查(from/fromName/itemId 是 string,
    //                       deliver 是 map,ts 是 number)
    //           ★ v3.12.2 ⑤ ts 必須是「最近一週內」的時間戳記
    //                       (用 request.time 對比,前後各 7 天緩衝)
    //                       防止玩家偽造未來時間擾亂領禮順序
    //   read, delete: 只有收禮者本人 / 管理員(隱私 + 防偷讀別人禮物清單)
    //   list: 只有收禮者本人 / 管理員(避免普通玩家撈別人的禮物紀錄)
    //   update: 不開放給玩家(禮物只有 create 與 delete 兩種狀態);管理員保留後門
    //
    // 安全考量:
    //   - hasOnly 5 欄位嚴格守門,玩家無法偷塞 coins/heroLevels/任何其他欄位
    //   - from 必須等於 auth.uid → 不能偽造他人身分送禮(否則可造假榜單)
    //   - 不能送自己 → 防止 farming(無限循環自己送自己累積友情之心)
    //   - read/list 限本人 → 不能查別人收了哪些禮物(隱私)
    //   - ★ v3.12.2 ts 必須接近現在時間 → 防排序攻擊
    // ════════════════════════════════════════════════════════════════
    match /players/{uid}/pendingGifts/{giftId} {
      // 讀:只有收禮者本人 / 管理員
      allow get: if isAdmin()
                 || (isRealUser() && request.auth.uid == uid);
      // list 限本人 / 管理員(收禮端 getDocs 整個 collection 用)
      allow list: if isAdmin()
                  || (isRealUser() && request.auth.uid == uid);
      // 寫入:任何登入者可寫別人的 pendingGift,但限制嚴格
      allow create: if isAdmin()
                    || (isRealUser()
                        && request.auth.uid != uid
                        && request.resource.data.from == request.auth.uid
                        // ★ v3.14.4(2026-06-10)— 加 msgIdx(勉勵話索引,老師需求 3)
                        //   hasOnly 是「只能有這些欄位」非「必須有」→ 舊版 client(不帶 msgIdx)仍可送
                        && request.resource.data.keys()
                           .hasOnly(['from','fromName','itemId','deliver','ts','msgIdx'])
                        // ★ v3.12.2 — 五欄位個別型別檢查
                        && request.resource.data.from is string
                        && request.resource.data.fromName is string
                        && request.resource.data.itemId is string
                        && request.resource.data.deliver is map
                        && request.resource.data.ts is number
                        // ★ v3.14.4 — msgIdx 若有帶,必須是 0-4 整數(對應 5 句固定勉勵話,防自由文字注入)
                        && (!request.resource.data.keys().hasAny(['msgIdx'])
                            || (request.resource.data.msgIdx is int
                                && request.resource.data.msgIdx >= 0
                                && request.resource.data.msgIdx <= 4))
                        // ★ v3.12.2 — ts 必須是「最近一週內」的時間戳記
                        //   request.time 是伺服器接到請求的時間(timestamp 型別)
                        //   一週 = 7×24×60×60×1000 = 604,800,000 毫秒
                        //   過去 7 天 ~ 未來 7 天緩衝(允許輕微時鐘偏移)
                        && request.resource.data.ts >= request.time.toMillis() - 604800000
                        && request.resource.data.ts <= request.time.toMillis() + 604800000);
      // update 不開放(禮物送出後不能修改;要改只能 delete 重 create)
      allow update: if isAdmin();
      // 刪:只有收禮者本人(領取後消化)/ 管理員
      allow delete: if isAdmin()
                    || (isRealUser() && request.auth.uid == uid);
    }

    // ════════════════════════════════════════════════════════════════
    // ★ v3.13.49(2026-06-05)補登 — 管理員通知玩家(登入後彈窗)
    // ────────────────────────────────────────────────────────────────
    // 情境:
    //   GM 後台(學生補償工具 / 異常清除 / 汙染英雄刪除預告套用…)呼叫
    //   _fbAdminSendNotificationToPlayer(uid, payload) → 寫一筆到
    //   pendingAdminNotifications/{uid}/items/{ts}
    //   玩家下次登入,client(_checkPendingAdminNotifications)讀取 + 彈窗 + 刪除。
    //
    // ⚠ 為什麼補這條:
    //   之前沒有這條 match → 寫入與讀取都掉進最底下的 `allow read, write: if false`
    //   (預設拒絕),導致「GM→玩家的登入彈窗通知」一直被擋掉、送不到玩家。
    //   (補償本身寫在 players/{uid},走 isAdmin 沒問題;只是少了這則說明彈窗。)
    //
    // 規則設計(比照 pendingGifts):
    //   create/update: 只有管理員能寄送(玩家不能自己塞通知/補償給自己)
    //   get/list:      收件者本人 / 管理員(玩家登入後讀自己的通知)
    //   delete:        收件者本人(讀完消化)/ 管理員
    //
    // 安全考量:
    //   - 寄送限 isAdmin → 玩家無法偽造「管理員補償」給自己刷資源
    //   - 讀/刪限本人 → 不能偷看或刪別人的通知
    // ════════════════════════════════════════════════════════════════
    match /pendingAdminNotifications/{uid}/items/{itemId} {
      // 寄送:只有管理員
      allow create, update: if isAdmin();
      // 讀:收件者本人 / 管理員
      allow get, list: if isAdmin()
                       || (isRealUser() && request.auth.uid == uid);
      // 刪:收件者本人(讀完消化)/ 管理員
      allow delete: if isAdmin()
                    || (isRealUser() && request.auth.uid == uid);
    }

    // ════════════════════════════════════════════════════════════════
    // ★ v3.13.74(2026-06-07)新增 — GM 課堂獎勵發放「送禮記錄」gmGiftLog
    // ────────────────────────────────────────────────────────────────
    // 情境:
    //   GM 後台「🎁 課堂獎勵發放」勾選獎勵(克雷爾 / 自選券 / 隨機券 / 水晶 /
    //   知識幣 / 果實)發給學生後,_fbWriteGmGiftLog 寫一筆到
    //   gmGiftLog/{auto-id} = { uid, label, email, items[], by, at }
    //   GM 後台「📜 查看送禮記錄」用 _fbReadGmGiftLog 讀(orderBy at desc)。
    //
    // 規則設計:
    //   read(get/list)、create:只有 GM。
    //   update/delete:不開放(發獎記錄屬稽核軌跡,寫了就不該被改/刪;
    //                  若日後需清理可臨時加 isAdmin delete)。
    //
    // 安全考量:
    //   - read/create 限 isAdmin → 玩家完全無法讀寫(裡面有其他學生的
    //     email / 真名標籤,屬隱私;也防玩家偽造「我收到 GM 大獎」記錄)。
    // ════════════════════════════════════════════════════════════════
    match /gmGiftLog/{logId} {
      allow read, create: if isAdmin();
    }

    // ★ v6170 — 雙槽存檔
    match /players/{uid}/saves/{slot} {
      allow read, write: if (isRealUser() && request.auth.uid == uid)
                         || isAdmin();
    }

    // ════════════════════════════════════════════════════════════════
    // ★ v5.280.0(2026-10-19・老師「每一次玩家新增或減少資源,都寫入雲端永久證明」「GM 獎勵記錄也永久保留」)
    //   永久資產帳本 players/{uid}/assetLedger/{時間_亂碼}
    //   = { uid, at, kind:'baseline'|'play'|'reconcile'|'grant', by, ver, e:[增減], snap_s?, note? }
    //   ・學生端:每 20 秒/離開時把資源增減寫成一頁;第一次登入新版寫「歸屬基準」頁。
    //   ・GM 發獎/補償/序號/救援(_fbCompensatePlayer):寫一頁 kind='grant'。
    // 規則設計:
    //   get/list: 本人 / 管理員
    //   create:   本人(data.uid 必須是自己、白名單欄位、e 是 list)或管理員(替學生記老師發放)
    //   update / delete:**任何人一律禁止,包含管理員** ⇒ 寫了就是永久證據,由伺服器保證不可竄改、不可刪除。
    // ════════════════════════════════════════════════════════════════
    match /players/{uid}/assetLedger/{pageId} {
      allow get, list: if isAdmin()
                       || (isRealUser() && request.auth.uid == uid);
      allow create: if (isAdmin()
                        || (isRealUser() && request.auth.uid == uid))
                    && request.resource.data.uid == uid
                    && request.resource.data.keys().hasOnly(['uid', 'at', 'kind', 'by', 'ver', 'e', 'snap_s', 'note'])
                    && request.resource.data.e is list
                    && request.resource.data.e.size() <= 2000
                    && request.resource.data.at is number;
      allow update, delete: if false;
    }

    // 在線狀態 (presence)
    match /presences/{uid} {
      allow read: if isRealUser();
      allow write: if isRealUser() && request.auth.uid == uid;
    }

    // ★ v3.4.13 修改 — stats/global:全服統計 + 世界 BOSS HP + 計數欄位
    //   管理員可寫任何欄位
    //   一般登入玩家:除了 maintenance / gmBroadcast 之外都可寫
    //   (玩家寫的都是 increment 計數欄位,如 worldBossHp、totalPlayers、
    //    totalAdventures、active_今日、newPlayers_本週、gmAck.公告id.uid、
    //    weeklyQuiz.{週key}.{uid}、weeklyQuizSettlement.{週key})
    // ★ v3.5.67 — 沿用原本「除 maintenance/gmBroadcast 都可寫」,
    //              已經涵蓋 weeklyQuiz / weeklyQuizSettlement 寫入
    // ★ v3.13.5 — 同樣涵蓋 wbSettlement / wbBossDownTimes / wbCurrentRound
    //              寫入(都是非 maintenance/gmBroadcast 欄位,不用額外開洞)
    // ★ v3.14.21 — 龍王輪替系統:wbCurrentBossId / worldBossHp / wbAdvanceLog / wbBlessing
    //              一律是非 maintenance/gmBroadcast 欄位 → 本「黑名單」規則已自動放行,
    //              玩家端「隔天 8:00 結算當下原子接班下一隻龍王」與祝福寫入皆不需改 rule。
    //              (僅 maintenance/gmBroadcast 保留 GM 專屬,維修與公告不被玩家覆蓋。)
    match /stats/{docId} {
      allow read: if true;
      allow write: if isAdmin()
                   || (isRealUser()
                       && !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['maintenance', 'gmBroadcast']));
    }

    // 邀請碼反查表 (加好友用)
    match /inviteCodes/{code} {
      allow read: if isRealUser();
      allow create, update: if (isRealUser()
                                && request.resource.data.uid == request.auth.uid)
                            || isAdmin();
    }

    // ★ v3.4.13 修改 — BUG / 卡死回報
    //   create:  任何登入玩家可建立自己的回報
    //   read:    玩家可讀自己的(uid 對得上)+ 管理員可讀全部
    //   update:  管理員可改任何欄位(寫 adminReply)
    //            玩家只能改自己回報的「已讀」欄位(adminReplyRead / adminReplyReadTs)
    //   delete:  管理員專用
    match /bugReports/{docId} {
      allow create: if isRealUser();

      allow read: if isAdmin()
                  || (isRealUser()
                      && resource.data.uid == request.auth.uid);

      allow update: if isAdmin()
                    || (isRealUser()
                        && resource.data.uid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['adminReplyRead', 'adminReplyReadTs']));

      allow delete: if isAdmin();
    }

    // ★ FIX 20260517(m) — 世界 BOSS 房間
    match /worldBossRooms/{roomId} {
      allow read: if isRealUser();
      allow create: if isRealUser()
                    && request.resource.data.meta.hostUid == request.auth.uid;
      allow update: if isRealUser();
      allow delete: if (isRealUser()
                       && resource.data.meta.hostUid == request.auth.uid)
                    || isAdmin();
    }

    // ★ v3.14.6 — PvP 連線對戰房間(雙人決鬥)
    //   設計:房主權威。host 全權寫;guest 僅四種受限寫入:
    //   ① 空位加入(只動 meta.guestUid/guestName) ② 選隊+ready(只動 teams)
    //   ③ 出手(只動 pendingAction) ④ 斷線判勝 claim(只動 result,且需
    //      battle.turnStartTs 距今已超過 60 秒 — 伺服器端強制,防惡意秒判)
    //   需知道 6 碼房號才讀得到,與 worldBossRooms 同信任慣例。
    match /pvpRooms/{roomId} {
      allow read: if isRealUser();
      allow create: if isRealUser()
                    && request.resource.data.meta.hostUid == request.auth.uid;
      allow update: if isRealUser() && (
                      // 房主:全權(推 battle / 清 pendingAction / 寫 result / 改 meta.status)
                      resource.data.meta.hostUid == request.auth.uid
                      // guest ① 空位加入:guestUid 為空 → 只能把自己填進去
                      || (resource.data.meta.guestUid == null
                          && request.resource.data.meta.guestUid == request.auth.uid
                          && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['meta']))
                      // guest ②③④:必須是已登記的 guest 本人
                      || (resource.data.meta.guestUid == request.auth.uid && (
                            // ② 選隊 / ready / 主動離房清空位(teams 或 meta+teams)
                            request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['teams'])
                            || request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['meta', 'teams'])
                            // ③ 出手
                            || request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['pendingAction'])
                            // ④ 斷線判勝:房主超過 60 秒沒推進戰局才允許
                            || (request.resource.data.diff(resource.data).affectedKeys()
                                  .hasOnly(['result'])
                                && resource.data.battle != null
                                && request.time > resource.data.battle.turnStartTs
                                                  + duration.value(60, 's'))
                         ))
                    );
      allow delete: if (isRealUser()
                       && resource.data.meta.hostUid == request.auth.uid)
                    || (isRealUser()
                       && resource.data.meta.status == 'ended')
                    || isAdmin();
    }

    // ★ FIX 20260517(m) — 世界 BOSS 邀請系統
    match /worldBossInvites/{inviteId} {
      allow read: if isRealUser()
                  && (resource.data.fromUid == request.auth.uid
                      || resource.data.toUid == request.auth.uid);
      allow create: if isRealUser()
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.toUid != request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update: if isRealUser()
                    && (resource.data.toUid == request.auth.uid
                        || resource.data.fromUid == request.auth.uid);
      allow delete: if isRealUser()
                    && (resource.data.fromUid == request.auth.uid
                        || resource.data.toUid == request.auth.uid);
    }

    // ★ v3.2 — 世界 BOSS 休戰期控制(管理員專用)
    match /worldBossControl/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ★ v3.2 — 全服共用狀態(預留)
    match /globalStats/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ★ v3.3.2 新增 — 世界 BOSS 排行榜(累積跨場戰績)
    match /worldBossLeaderboard/{bossId} {
      allow read: if true;
      allow write: if isRealUser();
    }

    // ★ v3.14.3 新增 — 世界 BOSS「逐回合 × 逐英雄」傷害明細(GM 後台查看用,每人一份 /{uid})
    //   read:  管理員可讀全部;玩家可讀自己那份
    //   write: 玩家只能寫自己 uid 那份,且整份只能含白名單 4 欄位(hasOnly 防偷塞其他資料)
    //   delete: 管理員專用
    match /wbDamageDetail/{uid} {
      allow read: if isAdmin()
                  || (isRealUser() && request.auth.uid == uid);
      allow create, update: if isRealUser()
                            && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['bossId', 'uid', 'battles', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════
    // ★ v3.5.0 新增 — 下載安裝權限管理(管理員批准制)
    // ────────────────────────────────────────────────────────────────
    // 規則:
    //   read:   玩家可讀自己的 / 管理員可讀任何
    //   list:   只有管理員可列(避免普通玩家撈出所有人的申請紀錄)
    //   create: 玩家只能建立自己的,而且 status 必須是 'pending'
    //           (不能自己給自己 approved)
    //   update: 玩家可改自己的(重新申請 pending),但不能動 grantedAt/
    //           grantedBy/expiresAt/revokedAt/revokedBy 這些只能管理員寫
    //           的欄位;status 也必須是 pending
    //           管理員可動任何欄位
    //   delete: 只有管理員可刪
    // ════════════════════════════════════════════════════════════════
    match /downloadPermissions/{uid} {
      // 玩家可讀自己的,管理員可讀任何
      allow get: if isAdmin()
                 || (isRealUser() && request.auth.uid == uid);
      // list 限管理員(避免一般玩家偷看別人申請紀錄)
      allow list: if isAdmin();

      // 玩家只能建立自己的 pending 申請
      allow create: if isAdmin()
                    || (isRealUser()
                        && request.auth.uid == uid
                        && request.resource.data.status == 'pending'
                        // 玩家不能自己塞批准相關欄位
                        && !('grantedAt' in request.resource.data)
                        && !('grantedBy' in request.resource.data)
                        && !('expiresAt' in request.resource.data));

      // 玩家可重新申請(改 pending),但不能動「批准/撤銷」相關欄位
      allow update: if isAdmin()
                    || (isRealUser()
                        && request.auth.uid == uid
                        && request.resource.data.status == 'pending'
                        && !request.resource.data.diff(resource.data).affectedKeys()
                           .hasAny(['grantedAt', 'grantedBy', 'expiresAt',
                                    'revokedAt', 'revokedBy']));

      // 只有管理員可刪
      allow delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════
    // ★ v3.15.6(2026-06-14)新增 — 畢業帳號資料轉移申請(實名制 GM 審核)
    // ────────────────────────────────────────────────────────────────
    // 情境:
    //   畢業生用「新 Google 帳號」登入(新 uid)→ 在登入頁帳號列點
    //   「📨 申請帳號資料轉移」填實名資訊(姓名/畢業年度/班級座號/原學生信箱)
    //   → 寫一筆到 accountTransferRequests/{新uid}(status='pending')。
    //   GM 後台「📨 帳號資料轉移審核」用舊信箱反查舊 uid,核對後「核准並遷移」:
    //   把舊 uid 的進度複製到新 uid(全搬),最後才停權舊帳號(可逆,母本不刪)。
    //
    // 規則設計(比照 downloadPermissions):
    //   get:    玩家可讀自己的 / 管理員可讀任何
    //   list:   只有管理員(避免學生撈別人的實名申請)
    //   create: 玩家只能建立自己的 pending(uid 對得上 + status='pending' +
    //           不能自己塞 GM 審核/遷移欄位)
    //   update: 玩家可重新申請(改回 pending),但不能動 GM 欄位;管理員全權
    //   delete: 只有管理員
    //
    // 安全考量:
    //   - 學生只能寫自己 doc(documentId == auth.uid),不能偽造別人的轉移申請
    //   - 學生塞不了 oldUid/resolvedBy/migratedAt 等 GM 欄位 → 不能自助遷移繞過審核
    //   - list / 實名資訊讀取限 GM → 保護學生個資(姓名/班級座號)
    //   - 遷移本身由 GM(isAdmin)在後台執行,走 players/saves 既有 isAdmin 路徑,
    //     不需在此額外開洞
    // ════════════════════════════════════════════════════════════════
    match /accountTransferRequests/{uid} {
      // 玩家可讀自己的,管理員可讀任何
      allow get: if isAdmin()
                 || (isRealUser() && request.auth.uid == uid);
      // list 限管理員(內含學生實名個資)
      allow list: if isAdmin();

      // 玩家只能建立自己的 pending 申請
      allow create: if isAdmin()
                    || (isRealUser()
                        && request.auth.uid == uid
                        && request.resource.data.status == 'pending'
                        && request.resource.data.newUid == request.auth.uid
                        // 玩家不能自己塞 GM 審核 / 遷移相關欄位
                        && !('oldUid' in request.resource.data)
                        && !('resolvedAt' in request.resource.data)
                        && !('resolvedBy' in request.resource.data)
                        && !('migratedAt' in request.resource.data));

      // 玩家可重新申請(改回 pending),但不能動 GM 欄位
      allow update: if isAdmin()
                    || (isRealUser()
                        && request.auth.uid == uid
                        && request.resource.data.status == 'pending'
                        && !request.resource.data.diff(resource.data).affectedKeys()
                           .hasAny(['oldUid', 'resolvedAt', 'resolvedBy',
                                    'migratedAt', 'gmNote']));

      // 只有管理員可刪
      allow delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════
    // ★ v3.5.18 新增 — 換帳號保護(共用平板情境)
    // ────────────────────────────────────────────────────────────────
    // 情境:
    //   小明在 iPad-01 打 BOSS 沒登出,小華第 2 節用同台登入自己帳號 →
    //   小華這台會在 _clearAccountLocalData 前,把小明的 adv_battle_snap
    //   暫存到 pendingHandoffs/{小明 uid},等小明下次登入時自己讀出來還原。
    //
    // 規則設計:
    //   write:  已登入 + 寫入者 != 受贈者本人
    //           (代表是「別人」正在幫他保存進度,小明自己不會寫自己的 handoff)
    //           ⚠ 一律放行讓任何登入者寫,因為「需要被救的小明」當下不在線上,
    //              是其他人(小華)代寫,所以不能限制寫入者身分
    //   get:    已登入 + 必須是 victimUid 本人才能讀
    //           (避免別人偷看小明的戰鬥快照)
    //   delete: 同上(只有 victimUid 本人能消化掉自己的 handoff)
    //   list:   不允許(避免普通玩家撈所有 handoff)
    //   管理員:全權(除錯/手動清理用)
    //
    // 安全考量:
    //   - 寫入者必須是已登入玩家(request.auth != null) → 防止匿名亂寫
    //   - 寫入者不能等於 victimUid → 防止小明自己寫自己的 handoff 繞過正常流程
    //   - 讀/刪只有 victimUid 本人 → 戰鬥快照內容只屬於本人
    //   - victimUid 不需事先存在於 players 集合(因為這時還沒登入)
    // ════════════════════════════════════════════════════════════════
    match /pendingHandoffs/{victimUid} {
      // 讀:只有受贈者本人 / 管理員
      allow get: if isAdmin()
                 || (isRealUser() && request.auth.uid == victimUid);
      // list 不開放(避免普通玩家撈名單)
      allow list: if isAdmin();
      // 寫(create + update):任何登入者 + 自己不是受贈者
      allow create, update: if isAdmin()
                            || (isRealUser()
                                && request.auth.uid != victimUid);
      // 刪:只有受贈者本人 / 管理員
      allow delete: if isAdmin()
                    || (isRealUser() && request.auth.uid == victimUid);
    }

    // ════════════════════════════════════════════════════════════════
    // ★ v3.13.15(2026-06-02) 補登 — 鬥技場玩家陣容池
    // ────────────────────────────────────────────────────────────────
    // 情境:
    //   玩家在鬥技場存的 5 個預設陣容槽 + 第 6 槽自動勝利槽,結構:
    //   arenaTeams/{uid} = { uid, email, displayLabel, lastUpdate,
    //                         slots: { '1': {...}, '2': {...}, ..., 'auto_win': {...} } }
    //   其他玩家(NPC 對戰用)會撈所有人的 arenaTeams 來組敵隊池子
    //
    // 規則設計:
    //   read:   所有登入玩家可讀(NPC 對戰需要撈所有人陣容當對手池)
    //   list:   所有登入玩家可讀(_arenaFetchTeamPool 用 getDocs)
    //   create/update: 只能寫自己的 doc(uid 對得上),且不可動停權欄位(若有)
    //                  document id 必須等於 auth.uid
    //   delete: 只有管理員(玩家不該手動刪自己的陣容,GM 處罰用)
    //
    // 安全考量:
    //   - 玩家 A 不能偽造 B 的陣容(documentId == auth.uid 強制)
    //   - 玩家 A 不能改 B 的陣容(同上)
    //   - 撈陣容池是合理需求(鬥技場核心玩法),不算隱私
    // ════════════════════════════════════════════════════════════════
    match /arenaTeams/{uid} {
      allow read, list: if isRealUser();
      allow create, update: if isAdmin()
                            || (isRealUser() && request.auth.uid == uid);
      allow delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════
    // ★ v3.13.15(2026-06-02) 補登 — 鬥技場系統預設 5 套陣容(GM 管理)
    // ────────────────────────────────────────────────────────────────
    // 情境:
    //   玩家池子空時(冷啟動或全部過期),用 GM 設定的 5 套保底陣容當對手
    //   arenaSystemTeams/main = { teams: [...5], updatedAt, updatedBy }
    //
    // 規則設計:
    //   read:   所有登入玩家可讀(鬥技場啟動時拉)
    //   write:  只有 GM(玩家不能改保底陣容)
    // ════════════════════════════════════════════════════════════════
    match /arenaSystemTeams/{docId} {
      allow read: if isRealUser();
      allow write: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════
    // ★ v3.13.20(2026-06-02) 新增 — 全站遊戲設定(GM 控制旗標集合)
    // ★ v3.13.30(2026-06-03) 補強 — anomaly_scan_cache 隱私守門
    // ────────────────────────────────────────────────────────────────
    // 情境:
    //   - gameConfig/arenaSwitch = { enabled, updatedAt, updatedBy }
    //     (鬥技場全站入口開關;arena.js 啟動時所有玩家拉狀態)
    //   - gameConfig/anomaly_scan_cache (v3.13.30 新增)
    //     = { ts, scannedBy, scanned, abnormal[], handled:{[uid]:{at,by}}, ... }
    //     GM 異常掃描快取,內含其他玩家 name/email/異常戰鬥/處理狀態,屬隱私
    //   未來可能加:其他全站 feature flag(世界 BOSS 戰開關、商店維修等)
    //
    // 規則設計:
    //   read:  「anomaly_scan_cache」doc 只 GM 可讀(內含玩家隱私資料);
    //          其他 doc(arenaSwitch 等)所有登入者可讀
    //   write: 全部只有 GM(玩家無法切開關或偽造異常名單)
    //
    // 安全考量:
    //   - 寫入限 GM → 玩家無法繞過維修狀態 / 偽造異常名單
    //   - 一般 doc 讀放給所有登入玩家,但不給 public → 防外部探測旗標
    //   - anomaly_scan_cache 讀限 GM → 不讓一般玩家撈他人 email/異常名單
    //
    // ★★ v5.96.0(2026-08-20)新增 — `gm_` 前綴 = GM 專用 doc,一律只有 GM 可讀 ★★
    //   起因:老師需求「每位學生加 GM『已處理』勾選欄」→ 標記要跨裝置/跨三個管理員
    //         帳號共用,故落地在 gameConfig/gm_handled_ura
    //         = { updatedAt, updatedBy, handled:{ [uid]:{ at, by, fp } } }。
    //   ⚠ 舊條款只擋住 `anomaly_scan_cache` 這一個 docId,其餘 gameConfig doc
    //     任何登入學生都讀得到 → 新的已處理名單(含全校 uid 與處理時間)會外洩。
    //   ⇒ 改為「docId 以 gm_ 開頭者只有 GM 可讀」。
    //     ★ 日後所有 GM 專用 doc(快取/已處理標記/內部統計)一律用 `gm_` 前綴命名,
    //       就自動受本條保護,**永遠不必再改這份規則**。
    //   (arenaSwitch / petSystemSwitch / classRewardBoost / avatarLocks 等
    //    玩家端要讀的旗標不帶 gm_ 前綴,行為完全不變。)
    // ════════════════════════════════════════════════════════════════
    //   ★ v5.195.0（2026-09-14・老師「三個入口都要被休息排程阻擋，避免學生半夜不睡覺肝遊戲」）
    //   `restSchedule` 這一個 doc **開放未登入讀取**：
    //     ・內容只有 { enabled, startHHMM, endHHMM, warnMin, restMessage, warnMessage, updatedAt, updatedBy }
    //       ＝休息幾點到幾點、給學生看的提示文字，**沒有任何玩家隱私**，公開讀零風險。
    //     ・理由：迷你遊戲模式與荒島求生是「訪客免登入」入口，訪客讀不到這份文件就擋不住，
    //       半夜照樣能玩。前端另有本機快取當備援，但完全沒登入過的新裝置只能靠這條規則。
    //     ・寫入仍限 isAdmin()（只有老師能改休息時間），與原本一致。
    match /gameConfig/{docId} {
      allow read:  if isAdmin()
                   || docId == 'restSchedule'
                   || (isRealUser()
                       && docId != 'anomaly_scan_cache'
                       && !docId.matches('^gm_.*'));
      allow write: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════
    // ★ v3.13.20(2026-06-02) 新增 — 鬥技場戰鬥記錄(GM 異常傷害審核)
    // ────────────────────────────────────────────────────────────────
    // 情境:
    //   每場鬥技場結算後,玩家客戶端 fire-and-forget 寫一筆到
    //   arenaBattles/{uid}_{ts} = { uid, email, displayLabel, teamName,
    //                                 heroes:[4], elements:[4], rounds,
    //                                 totalDmg, avgDmgPerRound, result, ts, v }
    //   GM 後台「⚔ 鬥技場戰鬥記錄審核」會 list 最近 500 筆排序檢查異常
    //
    // 規則設計:
    //   read, list: 只有 GM(玩家戰鬥資料屬隱私,且記錄裡有平均單回合傷害
    //                 等 GM 內部審核欄位,沒必要給其他玩家看)
    //   create: 任何登入玩家可建立,但限制:
    //           ① document id 開頭必須是自己的 uid(避免冒充別人寫)
    //           ② request.resource.data.uid == auth.uid(雙重保險)
    //           ③ hasOnly([12 欄位])(只能寫白名單,防擴充攻擊)
    //           ④ rounds 必須 1~10(鬥技場上限 10 回合)
    //           ⑤ totalDmg / avgDmgPerRound 必須 >= 0
    //           ⑥ result 必須是 'win'|'draw'|'lose' 其中之一
    //           ⑦ ts 必須接近 request.time(±1 天緩衝,防偽造時間)
    //   update: 不開放(戰鬥記錄不可改,只能 delete + create 重寫;
    //           GM 也不應改記錄,避免汙染審核基準)
    //   delete: 只有 GM(刪異常記錄、清舊資料)
    //
    // 安全考量:
    //   - documentId 開頭強制 = uid_ → 玩家無法用別人 uid 假裝寫紀錄陷害人
    //   - request.resource.data.uid == auth.uid → 雙重保險,防 documentId 與 data 不一致
    //   - hasOnly 12 欄位嚴格守門 → 不能塞額外欄位(例如惡意 `_isBoss=true` 之類)
    //   - rounds <= 10 + result 列舉 + dmg >= 0 → 防玩家偽造誇張資料
    //   - read 限 GM → 不算「公開排行」,保障玩家隱私(尤其是新手)
    //   - delete 限 GM → 玩家不能自己刪除自己作弊的記錄銷毀證據
    // ════════════════════════════════════════════════════════════════
    match /arenaBattles/{docId} {
      // 讀/列:GM 專屬(內含異常審核欄位,玩家不需要看)
      allow get, list: if isAdmin();

      // 建立:玩家寫自己的,嚴格守門
      allow create: if isAdmin()
                    || (isRealUser()
                        // ① document id 開頭必須是自己的 uid_
                        && docId.matches('^' + request.auth.uid + '_[0-9]+$')
                        // ② data.uid 必須等於 auth.uid(雙重保險)
                        && request.resource.data.uid == request.auth.uid
                        // ③ 白名單欄位(12 個)
                        && request.resource.data.keys().hasOnly([
                             'uid','email','displayLabel','teamName',
                             'heroes','elements','rounds','totalDmg',
                             'avgDmgPerRound','result','ts','v'
                           ])
                        // ④ 必要欄位個別型別檢查
                        && request.resource.data.uid is string
                        && request.resource.data.rounds is number
                        && request.resource.data.totalDmg is number
                        && request.resource.data.avgDmgPerRound is number
                        && request.resource.data.result is string
                        && request.resource.data.ts is number
                        // ⑤ rounds 在 1~10 之間(鬥技場上限)
                        && request.resource.data.rounds >= 1
                        && request.resource.data.rounds <= 10
                        // ⑥ 傷害數值不可為負
                        && request.resource.data.totalDmg >= 0
                        && request.resource.data.avgDmgPerRound >= 0
                        // ⑦ result 只能是 win/draw/lose
                        && request.resource.data.result in ['win','draw','lose']
                        // ⑧ ts 必須接近 request.time(±1 天緩衝,防偽造時間擾亂排序)
                        //    一天 = 86400000 毫秒
                        && request.resource.data.ts >= request.time.toMillis() - 86400000
                        && request.resource.data.ts <= request.time.toMillis() + 86400000);

      // 不允許 update(戰鬥記錄一旦寫入就是事實)
      allow update: if false;

      // 刪:只有 GM(刪異常記錄、清舊資料)
      allow delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════
    // ★ v3.15.54(2026-06-19)新增 — 鬥技場「逐回合×逐英雄×技能」傷害明細
    // ────────────────────────────────────────────────────────────────
    // 情境:
    //   每場鬥技場結算後,玩家客戶端旁路寫一筆到
    //   arenaDamageDetail/{uid_ts}(docId 與 arenaBattles/{uid_ts} 對齊,方便 GM 反查)
    //   = { uid, detail:[{r,h:[{n,d,by:[{s,d}]}]}], totalDmg, ts, v }
    //   GM 後台「⚔ 鬥技場戰鬥記錄審核」點「🔍 傷害明細」用 getDoc 讀該場,
    //   顯示是哪隻英雄、哪個技能在哪回合造成異常傷害(查 BUG 用)。
    //
    // 規則設計(完全比照 arenaBattles 的安全模型):
    //   get, list: 只有 GM(內含玩家逐回合傷害,屬審核資料,玩家不需看別人)
    //   create: 玩家寫自己的,嚴格守門:
    //           ① document id 開頭必須是自己的 uid_(避免冒充別人寫)
    //           ② request.resource.data.uid == auth.uid(雙重保險)
    //           ③ hasOnly([uid,detail,totalDmg,ts,v])(白名單,防擴充攻擊)
    //           ④ detail 是 list、totalDmg 是 number、ts 接近 request.time(±1 天)
    //   update: 不開放(明細寫入即事實);delete: 只有 GM
    //
    // 安全考量:
    //   - 與 arenaBattles 同:玩家無法用別人 uid 偽造明細;只能寫白名單欄位
    //   - read 限 GM → 保護玩家逐回合資料隱私
    //   - delete 限 GM → 玩家不能銷毀自己作弊的明細證據
    // ════════════════════════════════════════════════════════════════
    match /arenaDamageDetail/{docId} {
      // 讀/列:GM 專屬
      allow get, list: if isAdmin();

      // 建立:玩家寫自己的,嚴格守門
      allow create: if isAdmin()
                    || (isRealUser()
                        // ① document id 開頭必須是自己的 uid_
                        && docId.matches('^' + request.auth.uid + '_[0-9]+$')
                        // ② data.uid 必須等於 auth.uid(雙重保險)
                        && request.resource.data.uid == request.auth.uid
                        // ③ 白名單欄位(5 個)
                        && request.resource.data.keys().hasOnly([
                             'uid','detail','totalDmg','ts','v'
                           ])
                        // ④ 型別檢查
                        && request.resource.data.uid is string
                        && request.resource.data.detail is list
                        && request.resource.data.totalDmg is number
                        && request.resource.data.ts is number
                        // ⑤ ts 必須接近 request.time(±1 天緩衝,防偽造時間)
                        && request.resource.data.ts >= request.time.toMillis() - 86400000
                        && request.resource.data.ts <= request.time.toMillis() + 86400000);

      // 不允許 update(明細一旦寫入就是事實)
      allow update: if false;

      // 刪:只有 GM(刪異常記錄、清舊資料)
      allow delete: if isAdmin();
    }


    // ════════════════════════════════════════════════════════════════
    // ★ v3.15.26(2026-06-17)新增 — 虛寶序號兌換系統 redeemCodes
    // ────────────────────────────────────────────────────────────────
    // 情境:
    //   GM 後台「🎟️ 虛寶序號」勾選獎勵 + 數量批量產生「一次性序號」→
    //   _fbGenerateRedeemCodes 用 runTransaction(防撞號)寫 redeemCodes/{CODE};
    //   學生在主選單「🎟️ 序號兌換」輸入序號 → _fbRedeemCode 先 getDocFromServer
    //   讀單筆給友善訊息,再 runTransaction 原子標記 redeemed:true(誰先標記誰得),
    //   標記成功後才呼叫 _fbCompensatePlayer 發獎到自己(寧漏不重複刷)。
    //
    //   資料結構 redeemCodes/{CODE} = {
    //     code, reward(_fbCompensatePlayer payload), itemsLabel[],
    //     redeemed:bool, redeemedBy, redeemedByLabel, redeemedAt,
    //     expiresAt(0=永久), batchId, note, createdAt, createdBy, enabled
    //   }
    //
    // 規則設計:
    //   get:    任何登入者可讀單筆(學生兌換前要先讀序號;序號為 12 碼隨機,
    //           憑完整序號才查得到,與 worldBossRooms/pvpRooms「需知道房號」同信任慣例)
    //   list:   只有 GM(避免玩家撈出所有序號 + 內含 reward 獎勵內容 / createdBy)
    //   create: 只有 GM(批量產生序號)
    //   delete: 只有 GM(刪序號)
    //   update: 管理員全權;學生兌換僅能把 redeemed:false→true,且:
    //           ① resource.redeemed == false(原本未兌換 → 配合 transaction 防重複/搶兌)
    //           ② request.redeemed == true(必須是「標記為已兌換」,不能把別人的改回 false)
    //           ③ request.redeemedBy == auth.uid(兌換者必須是自己,防偽造他人兌換)
    //           ④ hasOnly([redeemed,redeemedBy,redeemedByLabel,redeemedAt])
    //              (只能動這 4 欄,動不了 reward/itemsLabel/expiresAt → 不能偷加獎勵或改有效期)
    //
    // 安全考量:
    //   - 玩家無法自己 create 序號 → 不能憑空發獎給自己(僅 GM 產生)
    //   - 玩家無法 list → 不能撈出全部序號暴力兌換(且 get 需完整序號)
    //   - update 僅 false→true + redeemedBy==自己 + hasOnly 4 欄 → 不能重複兌換、
    //     不能竄改獎勵內容、不能把別人兌過的序號改回未兌換
    //   - 「先標記 redeemed 再發獎」由 client 流程保證;rule 的 resource.redeemed==false
    //     確保並發時只有一人能成功標記(配合 runTransaction)
    // ════════════════════════════════════════════════════════════════
    match /redeemCodes/{code} {
      // 讀單筆:任何登入者(學生兌換需先讀;憑完整 12 碼序號才查得到)
      allow get: if isRealUser();
      // list:只有 GM(防玩家撈全部序號 + 保護 reward 內容)
      allow list: if isAdmin();
      // 產生 / 刪除:只有 GM
      allow create, delete: if isAdmin();
      // 更新:GM 全權;學生僅能把 redeemed false→true(且兌換者=自己、只動 4 欄)
      allow update: if isAdmin()
                    || (isRealUser()
                        && resource.data.redeemed == false
                        && request.resource.data.redeemed == true
                        && request.resource.data.redeemedBy == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['redeemed', 'redeemedBy',
                                     'redeemedByLabel', 'redeemedAt']));
    }

    // ═══════════════════════════════════════════════════════════════
    // ★ v3.15.55 補(對應 admin_panel.js v3.15.49 GM「🎉 全體玩家獎勵」)
    //   globalRewards：GM 建立的全班獎勵本體(title/items/note/enabled/expiresAt…)
    //   globalRewardClaims/{uid}_{rewardId}：每人每獎勵「一張認領文件」=防重複領取核心
    //   ① create-only(禁 update)→ 認領一旦寫入即定案,無法重寫/重領
    //   ② docId 前綴綁 auth.uid + data.uid==auth.uid → 玩家只能建立「自己的」認領文件,動不了別人的
    //   配合 index.html _fbClaimGlobalRewards 內 transaction(讀到已存在就跳過、不發獎),
    //   形成雙保險:免疫存檔三槽 richest-merge 復活、跨裝置/分頁同時登入都不會重複領。
    // ═══════════════════════════════════════════════════════════════
    match /globalRewards/{rewardId} {
      // 玩家登入要讀 enabled==true 清單來認領 → 開放「已登入者」讀
      allow get, list: if isRealUser();
      // 建立 / 停用啟用 / 刪除:只有 GM
      allow create, update, delete: if isAdmin();
    }

    match /globalRewardClaims/{claimId} {
      // 讀:本人(docId 前綴 = 自己 uid,用來查「我領過沒」)或 GM
      allow get, list: if isAdmin()
                       || (isRealUser()
                           && claimId.matches('^' + request.auth.uid + '_.+$'));
      // 建立:只能建立「自己的」認領文件(docId 前綴=uid、data.uid=uid、僅限 4 欄)
      allow create: if isRealUser()
                    && claimId.matches('^' + request.auth.uid + '_.+$')
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'rewardId', 'at', 'items']);
      // ★ 防重複領取核心:認領文件一旦寫入即「不可更動」→ 一律禁 update;GM 保留刪除供清理
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════
    // ★ v3.15.80(2026-06-22)新增 — 召喚紀錄雲端化 summonHistory/{uid}
    // ────────────────────────────────────────────────────────────────
    // 情境:
    //   玩家每次召喚後(星空抽 / 合成召喚卷 / 至寶券),_fbSaveSummonHistory
    //   把本地紀錄(最近 60 批)整包寫 summonHistory/{自己uid}(setDoc merge:false);
    //   登入時 _fbSyncSummonHistoryOnLogin 讀雲端↔本地去重合併保最新 60。
    //   GM 後台「📜 召喚紀錄」用 _fbReadPlayerSummonHistory 以 email/uid/學號
    //   反查 uid(在 players 集合 where email 查)後 getDoc 該玩家 summonHistory,
    //   檢視抽到的稀有英雄 / 台灣至寶 + 逐次明細,掌握解鎖來源。
    //
    //   資料結構:summonHistory/{uid} = { uid, list:[{t,free,n,items:[...]}], updatedAt }
    //
    // 規則設計:
    //   get:    玩家可讀自己的(登入同步)/ 管理員可讀任何(GM 後台查解鎖來源)
    //   list:   只有管理員(防玩家撈全體召喚紀錄;本功能 GM 是逐 uid getDoc、不需 list,
    //           此處僅防禦性保留 GM)
    //   create/update: 玩家只能寫自己的(documentId == auth.uid),且:
    //           ① data.uid == auth.uid(雙重保險,防偽造他人紀錄)
    //           ② hasOnly([uid,list,updatedAt])(白名單,防偷塞 coins/heroLevels 等其他欄位)
    //           ③ list is list、updatedAt is number(基本型別檢查)
    //           管理員全權(除錯 / 手動修)
    //   delete: 只有管理員(清理用;玩家不需刪自己的召喚紀錄)
    //
    // 安全考量:
    //   - documentId == auth.uid + data.uid == auth.uid → 玩家無法寫別人的召喚紀錄
    //   - hasOnly 3 欄 → 此文件不在玩家存檔載入路徑,即使被塞也不影響遊戲,但仍嚴格守門
    //   - read/list 限本人 / GM → 召喚紀錄屬個人資料,不對其他玩家公開
    //   - 未部署本規則時,雲端寫入被預設 deny 擋掉,但 client 本地紀錄仍正常
    //     (belt-and-suspenders;見 index.html _fbSaveSummonHistory catch)
    // ════════════════════════════════════════════════════════════════
    match /summonHistory/{uid} {
      // 讀:本人(登入同步)/ 管理員(GM 後台查)
      allow get: if isAdmin()
                 || (isRealUser() && request.auth.uid == uid);
      // list 限管理員(防撈全體;本功能不需 list)
      allow list: if isAdmin();
      // 寫:玩家只能寫自己的(documentId == auth.uid + data.uid == auth.uid + 白名單 3 欄)
      allow create, update: if isAdmin()
                            || (isRealUser()
                                && request.auth.uid == uid
                                && request.resource.data.uid == request.auth.uid
                                && request.resource.data.keys().hasOnly(['uid', 'list', 'updatedAt'])
                                && request.resource.data.list is list
                                && request.resource.data.updatedAt is number);
      // 刪:只有管理員
      allow delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════
    // ★ v3.17.6(2026-07-01)新增 — 召喚卷 UID 帳本 ticketLedger/{uid}
    // ────────────────────────────────────────────────────────────────
    // 情境:
    //   玩家每次「獲得/使用」召喚卷或自選卷,_recordTicketLedger 即 append 一筆
    //   { ev:'grant'|'use', item, n, uid(前12碼), at, result } 到本地並整包寫
    //   ticketLedger/{自己uid}(setDoc merge:false·append-only·永不主動刪個別紀錄);
    //   登入時 _fbSyncTicketLedgerOnLogin 讀雲端↔本地去重合併保最新 500。
    //   GM 救援審核時可讀該玩家帳本佐證「這帳號到底領/用過哪些券」(防亂救援刷券)。
    //
    //   資料結構:ticketLedger/{uid} = { uid, list:[{ev,item,n,uid,at,result}], updatedAt }
    //
    // 規則設計(完全鏡像 summonHistory 安全模型):
    //   get:    玩家可讀自己的(登入同步)/ 管理員可讀任何(GM 救援佐證)
    //   list:   只有管理員(防玩家撈全體;本功能 GM 逐 uid getDoc·不需 list)
    //   create/update: 玩家只能寫自己的(documentId == auth.uid + data.uid == auth.uid
    //           + 白名單 3 欄 uid/list/updatedAt + list is list + updatedAt is number)
    //   delete: 只有管理員(清理用;玩家不需刪自己的帳本)
    //
    // 安全考量:
    //   - documentId == auth.uid + data.uid == auth.uid → 玩家無法寫別人的召喚卷帳本
    //   - hasOnly 3 欄 → 此文件不在玩家存檔載入路徑,即使被塞也不影響遊戲,仍嚴格守門
    //   - read/list 限本人 / GM → 帳本屬個人資料,不對其他玩家公開
    //   - 未部署本規則時雲端寫入被預設 deny 擋掉,但 client 本地帳本仍正常(belt-and-suspenders)
    // ════════════════════════════════════════════════════════════════
    match /ticketLedger/{uid} {
      // 讀:本人(登入同步)/ 管理員(GM 救援佐證)
      allow get: if isAdmin()
                 || (isRealUser() && request.auth.uid == uid);
      // list 限管理員(防撈全體;本功能不需 list)
      allow list: if isAdmin();
      // 寫:玩家只能寫自己的(documentId == auth.uid + data.uid == auth.uid + 白名單 3 欄)
      allow create, update: if isAdmin()
                            || (isRealUser()
                                && request.auth.uid == uid
                                && request.resource.data.uid == request.auth.uid
                                && request.resource.data.keys().hasOnly(['uid', 'list', 'updatedAt'])
                                && request.resource.data.list is list
                                && request.resource.data.updatedAt is number);
      // 刪:只有管理員
      allow delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════
    // ★ v3.15.90(2026-06-23)新增 — 帳號救援申請(學生自助勾選·GM 權威審核)
    //   (v4.7.0 整理時補回本標題行;下方規則本體一字未動)
    // ────────────────────────────────────────────────────────────────
    // 情境:
    //   學生在關卡頁底部工具列點「📨 帳號救援申請」→ 先彈核對說明(雲端會先查
    //   遊戲記錄核對,確認是同步失敗的損失才修復)→ 勾選遺失的 英雄/至寶/召喚水晶/
    //   召喚卷/知識幣/排名獎勵(每天最多 1 次)→ 寫一筆到
    //   accountRescueRequests/{自己uid}(status='pending')。
    //   GM 後台「📨 帳號救援申請審核」list 待處理 → 開申請時自動跑
    //   _fbRebuildAccountFromLedgers(uid)(權威·只增不減)對照學生勾選標 符合/不符合,
    //   GM 確認後走 _fbApplyAccountRebuild 補回(套用前讀當下資料 max-merge·避免過量補償)。
    //
    //   資料結構 accountRescueRequests/{uid} = {
    //     uid, email, displayLabel,
    //     claims:{heroes,treasures,crystal,ticket,coins,rankAward 六布林},
    //     selfCheck:{...學生端初判摘要,僅供 GM 一覽參考,不參與補償計算},
    //     status:'pending'|'resolved'|'rejected', requestDateStr, createdAt,
    //     resolvedAt, resolvedBy, gmNote(GM 寫)
    //   }
    //
    // 規則設計(比照 accountTransferRequests / downloadPermissions 安全模型):
    //   get:    玩家可讀自己的(每日上限檢查)/ 管理員可讀任何
    //   list:   只有管理員(避免學生撈別人的申請)
    //   create: 玩家只能建立自己的 pending(documentId == auth.uid + data.uid == auth.uid
    //           + status='pending' + 白名單欄位 + 不能自己塞 GM 審核欄位)
    //   update: 玩家可重新申請(改回 pending,不能動 GM 審核欄位);管理員全權
    //   delete: 只有管理員
    //
    // 安全考量:
    //   - documentId == auth.uid + data.uid == auth.uid → 玩家無法偽造別人的救援申請
    //   - ★ 補償一律由 GM 端 _fbApplyAccountRebuild 從「雲端帳本」權威反推,完全不採信
    //     學生寫入的 claims/selfCheck(那只是給 GM 一覽參考)→ 玩家無法藉偽造刷資源
    //   - list / GM 審核欄位限 GM → 保護其他學生隱私、防自助核准
    // ════════════════════════════════════════════════════════════════
    match /accountRescueRequests/{uid} {
      // 讀:本人(每日上限檢查)/ 管理員
      allow get: if isAdmin()
                 || (isRealUser() && request.auth.uid == uid);
      // list 限管理員(防學生撈別人申請)
      allow list: if isAdmin();
      // 建立:玩家只能建立自己的 pending(documentId==uid + data.uid==uid + 白名單 + 不塞 GM 欄位)
      allow create: if isAdmin()
                    || (isRealUser()
                        && request.auth.uid == uid
                        && request.resource.data.uid == request.auth.uid
                        && request.resource.data.status == 'pending'
                        && !('resolvedAt' in request.resource.data)
                        && !('resolvedBy' in request.resource.data)
                        && !('gmNote' in request.resource.data)
                        && request.resource.data.keys().hasOnly([
                             'uid', 'email', 'displayLabel', 'claims', 'selfCheck',
                             'status', 'requestDateStr', 'createdAt'
                           ]));
      // 更新:玩家可重新申請(改回 pending,不能動 GM 審核欄位);管理員全權
      allow update: if isAdmin()
                    || (isRealUser()
                        && request.auth.uid == uid
                        && request.resource.data.status == 'pending'
                        && !request.resource.data.diff(resource.data).affectedKeys()
                           .hasAny(['resolvedAt', 'resolvedBy', 'gmNote']));
      // 刪:只有管理員
      allow delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════
    // ★ v3.16.65(2026-06-28)新增 — GM 課堂獎勵「拉取制」收件(逐玩家) + 認領防重複
    // ────────────────────────────────────────────────────────────────
    // 情境:
    //   GM「🎁 課堂獎勵發放」改為「指派待領取」→ _fbWriteGmClassReward 寫
    //   gmClassRewards/{uid}/items/{autoId} = { uid, label, email,
    //     reward(_fbCompensatePlayer payload), itemsLabel[], merit(事蹟), by, at, enabled:true }
    //   學生在主選單「🎁 GM獎勵」收件區看到「事蹟 + 獎項名稱數量」→ 按「確認領取」:
    //   _fbClaimGmClassReward 對「獨立認領文件」gmClassRewardClaims/{uid}_{rewardId} 做
    //   transaction(create-only),認領成功才以「伺服器重讀的權威 reward」_fbCompensatePlayer 入帳。
    //
    // 規則設計(完全鏡像 globalRewards / globalRewardClaims 防重複模型):
    //   gmClassRewards/{uid}/items/{rewardId}:
    //     get/list: 收件者本人(讀自己待領清單)/ 管理員
    //     create/update/delete: 只有 GM(玩家不能自己塞獎勵給自己·尤其 UR 英雄)
    //   gmClassRewardClaims/{claimId}:
    //     get/list: 本人(docId 前綴=自己 uid·查「我領過沒」)/ 管理員
    //     create: 只能建立「自己的」認領文件(docId 前綴=uid·data.uid=uid·僅限白名單 4 欄)
    //     update: 一律禁(認領文件一旦寫入即不可更動 → 防重複/跨裝置/免疫三槽 richest-merge 復活)
    //     delete: 只有 GM(清理用)
    //
    // 安全考量:
    //   - 玩家無法 create gmClassRewards → 不能憑空發 UR 給自己(僅 GM 指派)
    //   - 玩家只能讀/領「自己 uid」的收件箱 → 共用 iPad 上別人看不到也領不到你的獎勵(嚴防同裝置帳號污染)
    //   - 認領文件 create-only + docId 前綴綁 uid + 配合 client transaction → 永不重複領取
    //   - 入帳本身由玩家 _fbCompensatePlayer 寫自己 players/{uid} 及 saves/*(既有 self-write 規則涵蓋,無需新增)
    // ★ v5.317.0(搶答擂台・老師裁定 Q9 甲)— 新增「主持人照固定獎勵表發放」一條 create 路徑:
    //   只能是 GM 匯入的主持人、只能發給「自己主持且已結束」那一場的參加者、
    //   獎勵內容只能是三級固定表其中之一、文件 id 固定 lq_{房號}_{開房時間} ⇒ 每人每場只能一筆(create-only)。
    //   GM(isAdmin)路徑完全不變。
    // ★ v5.336.0 免登入同學的獎勵只走 GM(isAdmin)路徑匯入,本條不變
    // ════════════════════════════════════════════════════════════════
    match /gmClassRewards/{uid}/items/{rewardId} {
      // 讀:收件者本人(看自己的待領清單)/ 管理員
      allow get, list: if isAdmin()
                       || (isRealUser() && request.auth.uid == uid);
      // 寫 / 停用 / 刪除:只有 GM(玩家不能自己塞獎勵給自己)
      // ★ v5.317.0 主持人只能 create 固定表搶答擂台獎勵(見上方說明與 lqHostRewardOk)
      allow create: if isAdmin() || lqHostRewardOk(uid, rewardId);
      allow update, delete: if isAdmin();
    }

    match /gmClassRewardClaims/{claimId} {
      // 讀:本人(docId 前綴=自己 uid·查「我領過沒」)或 GM
      allow get, list: if isAdmin()
                       || (isRealUser()
                           && claimId.matches('^' + request.auth.uid + '_.+$'));
      // 建立:只能建立「自己的」認領文件(docId 前綴=uid·data.uid=uid·僅限 4 欄)
      allow create: if isRealUser()
                    && claimId.matches('^' + request.auth.uid + '_.+$')
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'rewardId', 'at', 'items']);
      // ★ 防重複領取核心:認領文件一旦寫入即不可更動 → 一律禁 update;GM 保留刪除供清理
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════
    // ★ v5.16.0(2026-08-06)新增 — 動態內容層 dynamicContent(GM 遊戲內直接擴充)
    // ────────────────────────────────────────────────────────────────
    // 情境:
    //   GM 在後台「📚 動態題庫擴充」新增題目 → 寫入本集合;
    //   全體玩家開機時讀 _index 比對版本(版本相同僅 1 讀),有更新才拉題包,
    //   合併進 ADV_QUIZ_DB(id>=100000 專屬區段,永不與靜態題庫相撞)。
    //   文件:_index = { quizVer, quizPacks:[], quizNextId, updatedAt }
    //         quiz_N = { list:[題目…], count, updatedAt }(每包 1800 題防 1MB 上限)
    //   未來二~四期(造型配件/寵物魔物/英雄BOSS)同樣落在本集合,
    //   規則一次到位,之後擴充不需再改本檔。
    //
    // 規則設計:
    //   read: 任何登入玩家(開機載入合併用;內容為全體共享的遊戲資料,無隱私)
    //   write/delete: 只有管理員(玩家絕不可能塞題目/竄改內容)
    // ════════════════════════════════════════════════════════════════
    match /dynamicContent/{docId} {
      allow read: if isRealUser();
      allow create, update, delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════
    // ★ v5.140.0(2026-09-04)新增／v5.146.0 補回 — 小遊戲最佳成績 minigameScores/{uid}
    //   (v5.140.0 已交付本段,但專案知識庫的本檔遺失了它;本輪重新補回,內容同原設計)
    //   小遊戲 minigame/index.html 登入後只寫 minigameScores/{自己uid} = { uid, name, games:{gid:{score,stars,acc,time,at}} }
    //   read:  本人 / 管理員;   create/update: 本人且 data.uid == auth.uid;   delete: 管理員
    // ════════════════════════════════════════════════════════════════
    match /minigameScores/{uid} {
      allow get: if isAdmin()
                 || (isRealUser() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, update: if isAdmin()
                            || (isRealUser()
                                && request.auth.uid == uid
                                && request.resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════
    // ★ v1.90.0(2026-09-12)新增 — 小遊戲《像素荒島求生記》存檔 minigameIsland/{uid}
    // ────────────────────────────────────────────────────────────────
    // 情境:
    //   小遊戲荒島求生模式(minigame_index.html 的 isl* 區塊)登入後把整份存檔
    //   ISL(角色/資源/建築/圖鑑/好友…)整份 set() 到 minigameIsland/{自己uid};
    //   訪客(未登入)只存 localStorage,不碰這個 collection(裝置共用島,見 v1.103.0)。
    //
    // 規則設計(完全鏡像既有 minigameScores):
    //   read:  本人 / 管理員(自己的島只有自己看得到,GM 可稽核)
    //   create/update: 本人且 data.uid == auth.uid(不能寫別人的島);管理員全權
    //   delete: 只有管理員
    //
    // 安全考量:
    //   - 存檔內容(貝幣/資源/建築等級)只影響玩家自己的島,不涉及排行榜或跨玩家寫入,
    //     不需要 hasOnly 欄位白名單(與 players 主檔的高風險欄位不同)。
    //   - data.uid == auth.uid 防止 A 把自己的存檔寫進 B 的 uid 文件(跨裝置換帳號污染的最後一道防線,
    //     配合 minigame_index.html v1.103.0 的所有權/血統守門一起生效)。
    // ════════════════════════════════════════════════════════════════
    match /minigameIsland/{uid} {
      allow get: if isAdmin()
                 || (isRealUser() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, update: if isAdmin()
                            || (isRealUser()
                                && request.auth.uid == uid
                                && request.resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════
    // ★ v1.401.0(2026-10-19)新增 — 荒島存檔永久備份 minigameIsland/{uid}/archive/{id}
    //   換裝置時兩份存檔(雲端/本機)較舊那份被取代前、衝突視窗被蓋掉的那份,都先整份備份到這裡。
    //   只增不改不刪(連管理員也不能改/刪),作為之後學生進度異常的還原依據;GM 主後台「🏝 荒島存檔備份」可查看與還原。
    // ════════════════════════════════════════════════════════════════
    match /minigameIsland/{uid}/archive/{arcId} {
      allow get, list: if isAdmin() || (isRealUser() && request.auth.uid == uid);
      allow create: if (isAdmin() || (isRealUser() && request.auth.uid == uid))
                    && request.resource.data.uid == uid
                    && request.resource.data.keys().hasOnly(['uid','at','why','from','day','shell','codexN','created','updatedAt','ver','data_s'])
                    && request.resource.data.data_s is string
                    && request.resource.data.at is number;
      allow update, delete: if false;
    }

    // ════════════════════════════════════════════════════════════════
    // ★ v1.104.0(2026-09-12)新增 — 小遊戲《像素荒島求生記》好友名片 minigameIslandPublic/{uid}
    // ────────────────────────────────────────────────────────────────
    // 情境:
    //   荒島求生「好友守夜」功能(H 甲互加不需同意、I 甲好友小人自動守夜不需在線):
    //   雲端存檔成功後(每 5 分鐘最多一次),玩家把一份「公開名片」寫到自己的
    //   minigameIslandPublic/{自己uid} = { uid, name, code(6碼好友碼), char(外觀),
    //   day, defLv, campLv, codex, updatedAt } —— 不含物品、貝幣、存檔本體。
    //   加好友時用好友碼查詢:where('code','==',code).limit(1)。
    //
    // 規則設計:
    //   get:  任何登入者(讀好友名片,供夜襲小人與好友面板顯示用;內容不含隱私資料)
    //   list: 任何登入者,但一次最多 1 筆(request.query.limit<=1)—— 只允許
    //         「用好友碼查一個人」,擋掉把整個名片集合撈下來的批次列出。
    //   create/update: 本人且 data.uid == auth.uid 且 code 必須是字串(防塞入非預期結構);管理員全權。
    //   delete: 本人或管理員。
    //
    // 安全考量:
    //   - 名片內容刻意排除物品包/倉庫/貝幣等任何有價值的資料,即使被任何登入者讀取也不構成隱私或
    //     遊戲平衡風險。
    //   - list 的 limit<=1 守門,防止有人繞過好友碼機制批次抓取全校名片做排行或騷擾。
    //   - 好友清單本身(哪些 uid 互為好友)存在玩家自己的 minigameIsland/{uid}.friends,
    //     不落在這個公開集合裡。
    // ════════════════════════════════════════════════════════════════
    match /minigameIslandPublic/{uid} {
      allow get: if isRealUser();
      allow list: if isRealUser() && request.query.limit <= 1;
      allow create, update: if isAdmin()
                            || (isRealUser()
                                && request.auth.uid == uid
                                && request.resource.data.uid == request.auth.uid
                                && request.resource.data.code is string);
      allow delete: if isAdmin() || (isRealUser() && request.auth.uid == uid);
    }

    // ════════════════════════════════════════════════════════════════
    // ★ v1.106.0(2026-09-12)新增 — 小遊戲《像素荒島求生記》好友信箱 minigameIsland/{uid}/mail/{mailId}
    // ────────────────────────────────────────────────────────────────
    // 情境:
    //   營地「📬 信箱」送物資(islMailSendGift)/留言(islMailSendNote)寫入對方的
    //   minigameIsland/{收件者uid}/mail/{autoId} = { from, fromName, type:'gift'|'note',
    //   items?{資源id:數量}(恰 1 種)、text?(留言≤40字)、at }。收件者開信箱讀取、逐筆刪除。
    //
    // 規則設計(鏡像既有 pendingGifts 的信任模型):
    //   get/list: 本人 / 管理員(自己的信箱只有自己看得到)
    //   create:   任何登入者,但 from 必須是自己、不能寄給自己、6 欄位白名單、
    //             type 限 gift/note、note 文字 ≤40 字、gift 恰 1 種物品、
    //             at 是一週內的時戳(防偽造排序,不擋合理的網路延遲)
    //   update:   禁止(信件內容不可事後竄改)
    //   delete:   本人 / 管理員
    //
    // 安全考量:
    //   - 物資數量本身不在 rules 端驗證(信任雙方帳號互動,交由 log 事後稽核,同 pendingGifts)。
    //   - from == auth.uid 防止冒名頂替寄件人。
    // ════════════════════════════════════════════════════════════════
    match /minigameIsland/{uid}/mail/{mailId} {
      allow get, list: if isAdmin() || (isRealUser() && request.auth.uid == uid);
      allow create: if isRealUser()
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.from != uid
                    && request.resource.data.keys().hasOnly(['from','fromName','type','items','text','at'])
                    && request.resource.data.type in ['gift','note']
                    && (request.resource.data.type != 'note'
                        || (request.resource.data.text is string && request.resource.data.text.size() <= 40))
                    && (request.resource.data.type != 'gift'
                        || (request.resource.data.items is map && request.resource.data.items.size() == 1))
                    && request.resource.data.at is number
                    && request.resource.data.at <= request.time.toMillis() + 60000
                    && request.resource.data.at >= request.time.toMillis() - 7*24*60*60*1000;
      allow update: if false;
      allow delete: if isAdmin() || (isRealUser() && request.auth.uid == uid);
    }

    // ════════════════════════════════════════════════════════════════
    // ★ v1.108.0(2026-09-12)新增 — 小遊戲《像素荒島求生記》好友連線合作 minigameIslandVisit/{ownerUid}
    // ────────────────────────────────────────────────────────────────
    // 情境:
    //   拜訪好友的島(islCoopJoin/islCoopLeave):把自己的 uid 加進/移出島主的
    //   minigameIslandVisit/{島主uid}.slotUids(最多 4 人同島),並在
    //   minigameIslandVisit/{島主uid}/players/{自己uid} 回報即時位置(供其他人畫出小人),
    //   離線時把自己標成 npc:true(不即時刪除,讓島主知道「這個人剛剛在但離線了」)。
    //   notices 是輕量文字通知(「OOO 來拜訪你的島了」「OOO 已離線,先留在島上」…),
    //   島主開機時讀一次、顯示後清空(islCoopNoticesCheck)。
    //
    // 規則設計(低風險內容,信任模型比照 minigameIslandPublic/pendingGifts):
    //   頂層文件 slotUids/notices 不含任何物品/貝幣/存檔本體,任何登入者都能寫入
    //   (需要這樣,因為寫入者是「來訪的客人」不是島主本人),但用 hasOnly + 型別/長度
    //   限制擋住亂塞欄位或洗版式灌爆陣列。
    //   players 子集合每份文件只有本人能寫自己的(uid == auth.uid),島主或本人都能刪除
    //   (島主可以把太久沒動靜的訪客清出去)。
    //
    // 安全考量:
    //   - slotUids 上限 4、notices 上限 20 筆,擋洗版式灌爆陣列造成文件過大。
    //   - players 文件 uid 欄位必須等於 auth.uid,防止冒名塞入別人的座標覆蓋畫面。
    // ════════════════════════════════════════════════════════════════
    match /minigameIslandVisit/{ownerUid} {
      allow get, list: if isRealUser();
      allow create, update: if isAdmin()
                            || (isRealUser()
                                && request.resource.data.keys().hasOnly(['ownerUid','slotUids','notices','updatedAt'])
                                && request.resource.data.ownerUid == ownerUid
                                && request.resource.data.slotUids is list
                                && request.resource.data.slotUids.size() <= 4
                                && (!('notices' in request.resource.data)
                                    || (request.resource.data.notices is list && request.resource.data.notices.size() <= 20)));
      allow delete: if isAdmin() || (isRealUser() && request.auth.uid == ownerUid);
    }
    match /minigameIslandVisit/{ownerUid}/players/{playerUid} {
      allow get, list: if isRealUser();
      allow create, update: if isAdmin()
                            || (isRealUser()
                                && request.auth.uid == playerUid
                                && request.resource.data.uid == playerUid);
      allow delete: if isAdmin()
                    || (isRealUser() && (request.auth.uid == playerUid || request.auth.uid == ownerUid));
    }

    // ════════════════════════════════════════════════════════════════
    // ★ v5.146.0(2026-09-07)新增 — 小遊戲「每週排行榜獎勵」
    // ────────────────────────────────────────────────────────────────
    // 情境:
    //   小遊戲(minigame/index.html v1.10.0)登入後每局把「本週最高分」寫進
    //   stats/minigameWeekly.weeks[週][自己uid] = { n, g:{gid:score}, at }(set merge);
    //   主程式(index.html v5.146.0 _minigameRank)週一 08:00 後第一位登入者 transaction
    //   結算上週 → 寫 stats/minigameWeekly.settlement[週](結算包)並刪 weeks[週];
    //   玩家登入讀結算包找自己 → 同一 transaction 內:
    //     ① 建立認領文件 minigameRankClaims/{uid}_{週}(create-only)
    //     ② 自己 players/{uid} 加知識幣 / 背包(既有 self-write 規則涵蓋)
    //
    // 規則設計:
    //   stats/minigameWeekly:既有 /stats/{docId} 規則已允許「登入者 update(非 maintenance/gmBroadcast)」
    //     與「任何人 read」;但 create 時 resource 為 null,既有 diff 表達式會出錯而拒絕 →
    //     這裡補一條「登入者可 create」(小遊戲老師端登入會自動建檔,本條是雙保險)。
    //   minigameRankClaims/{claimId}(完全鏡像 globalRewardClaims 防重複模型):
    //     get/list: 本人(docId 前綴=自己 uid)/ 管理員
    //     create:   只能建立「自己的」認領文件(docId 前綴=uid、data.uid=uid、白名單 5 欄、weekKey 是字串)
    //     update:   一律禁(認領一旦寫入即定案 → 跨裝置/多分頁/三槽合併都不會重複領)
    //     delete:   只有 GM(清理用)
    //
    // 安全考量:
    //   - 週成績寫在 stats 共用文件,學生只會 set merge 自己那一格;惡意改別人格子的風險與
    //     既有 weeklyQuiz / arenaWeekly 相同(結算時以雲端資料為準,GM 可事後稽核)。
    //   - 認領文件 create-only + docId 綁 uid → 玩家無法替別人領、也無法重複領。
    //   - 發獎內容(幣/水晶/書)由 client 從結算包讀取後寫自己主檔(同 arenaRankClaimed 模型)。
    // ════════════════════════════════════════════════════════════════
    match /stats/minigameWeekly {
      allow read: if true;
      allow create: if isRealUser();
    }

    match /minigameRankClaims/{claimId} {
      // 讀:本人(docId 前綴=自己 uid)或 GM
      allow get, list: if isAdmin()
                       || (isRealUser()
                           && claimId.matches('^' + request.auth.uid + '_.+$'));
      // 建立:只能建立「自己的」認領文件(docId 前綴=uid、data.uid=uid、僅限 5 欄)
      allow create: if isRealUser()
                    && claimId.matches('^' + request.auth.uid + '_.+$')
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'weekKey', 'rank', 'gid', 'at'])
                    && request.resource.data.weekKey is string;
      // ★ 防重複領取核心:認領文件一旦寫入即不可更動 → 一律禁 update;GM 保留刪除供清理
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════
    // ★ v5.317.0(2026-11-01・老師「小英雄首頁新增連線搶答模式(類似 KAHOOT)」)— ⚡ 搶答擂台
    // ────────────────────────────────────────────────────────────────
    // 設計書:專案知識庫 claude/連線搶答模式_設計書.md
    // 資料:
    //   liveQuizHosts/{email小寫}              GM 匯入的「主持人」名單(一個 email 一份文件)
    //   liveQuizRooms/{6碼}                    房間狀態(只有房主寫;題目不含正解,公布時才寫 reveal.answer)
    //     /players/{uid}                       參加者(學生只能建立/更新自己的,主持人可踢人)
    //     /answers/{uid}_{題號}                作答(create-only,一題一次,伺服器時間戳,逾時無效)
    //     /powerups/{uid}_{cut|hint}           法寶請求(create-only ⇒ 每種每場只能用 1 次)
    //     /private/{uid}                       法寶結果(只有本人與房主讀得到,正解不外流)
    //     /host/{docId}                        房主私有(含正解的整份題目、計分備份;斷線回房用)
    //   liveQuizBoard/{docId}                  首頁橫幅「有人開擂台」看板(只放房號/標題/主持人)
    //   liveQuizHistory/{id}                   場次永久紀錄(排名、頒獎清單)
    //   liveQuizSets/{id}                      主持人自訂題組
    // 安全:
    //   - 學生寫不到分數(分數由房主讀 answers 計算),也讀不到別人的作答與法寶結果
    //   - 作答時間一律 request.time(伺服器時間),手動改裝置時鐘無效
    //   - 主持人(非 GM)頒獎只能照固定三級獎勵表(老師裁定 Q9 甲),見上方 gmClassRewards 條款與檔頭 lqHostRewardOk
    //   - 共用函式 isLqHost / lqRoom / lqIsRoomHost / lqPlayerOk / lqAnswerOk / lqPowerOk / lqHostRewardOk 放在檔頭
    // ★ v5.318.0 players 允許 syncAt(伺服器時間對時,學生倒數＝雲端截止)
    // ★ v5.323.0 players 允許連線診斷 rtt(上次心跳來回毫秒)/ lag(畫面卡頓毫秒)/ dev(裝置標籤 ≤40 字),只給主持台的「📶 連線診斷」看
    // ★ v5.336.0(2026-11-03・老師「搶答擂台新增免登入模式,讓玩家自己輸入班級座號」)
    //   players 新增「免登入加入」create 路徑:只在房間 meta.guest == true(主持人開房時勾「允許免登入」)才放行;
    //   身分必須是匿名登入(request.auth.token.firebase.sign_in_provider == 'anonymous'),文件 id 仍綁 auth.uid;
    //   email 一律空字串、code = 4 碼班級座號(年級 1-6/班級 1-9/座號 2 碼)、guest == true;其餘欄位白名單同一般。
    //   作答/法寶/心跳沿用原本條款(都只認 auth.uid,匿名身分一樣受「一題一次、伺服器時間、逾時無效」保護)。
    //   ⚠ 前端用獨立的 Firebase App(lqGuest)做匿名登入,主程式的 Google 登入與玩家存檔完全不受影響;
    //     需在 Firebase 主控台 Authentication → 登入方式 開啟「匿名」。
    //   免登入同學的獎勵:主持人不能發(lqHostRewardOk 要求 players 文件 id = 收件 uid,匿名 uid 沒有收件箱),
    //   由 GM 依班級座號對名冊找到帳號 uid 後走 isAdmin 路徑寫 gmClassRewards(同一場固定 id,同人不重複)。
    // ════════════════════════════════════════════════════════════════
    match /liveQuizHosts/{email} {
      allow get: if isAdmin()
                 || (isRealUser() && request.auth.token.email.lower() == email);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /liveQuizRooms/{pin} {
      allow read: if request.auth != null;
      allow create: if isLqHost()
                    && pin.matches('^[0-9]{6}$')
                    && request.resource.data.meta.hostUid == request.auth.uid
                    && request.resource.data.meta.createdAt is int;
      allow update: if isAdmin()
                    || (isLqHost()
                        && resource.data.meta.hostUid == request.auth.uid
                        && request.resource.data.meta.hostUid == request.auth.uid
                        && request.resource.data.meta.createdAt == resource.data.meta.createdAt);
      allow delete: if isAdmin();

      match /players/{uid} {
        allow read: if request.auth != null;
        allow create: if (request.auth != null
                          && request.auth.token.firebase.sign_in_provider != 'anonymous'
                          && request.auth.uid == uid
                          && request.resource.data.uid == uid
                          && request.resource.data.kicked == false
                          && request.resource.data.email == request.auth.token.email.lower()
                          && request.resource.data.keys().hasOnly(['uid', 'name', 'account', 'email', 'joinedAt', 'lastSeen', 'kicked', 'syncAt'])
                          && lqRoom(pin).meta.status != 'ended'
                          && lqRoom(pin).meta.locked != true)
                      // ★ v5.336.0 免登入加入:匿名身分(lqGuest)＋房間有開放免登入＋4 碼班級座號(年級 1-6、班級 1-9、座號 2 碼)
                      || (request.auth != null
                          && request.auth.token.firebase.sign_in_provider == 'anonymous'
                          && request.auth.uid == uid
                          && request.resource.data.uid == uid
                          && request.resource.data.kicked == false
                          && request.resource.data.guest == true
                          && request.resource.data.email == ''
                          && request.resource.data.code is string
                          && request.resource.data.code.matches('^[1-6][1-9][0-9][0-9]$')
                          && request.resource.data.name is string
                          && request.resource.data.name.size() <= 30
                          && request.resource.data.keys().hasOnly(['uid', 'name', 'account', 'email', 'joinedAt', 'lastSeen', 'kicked', 'syncAt', 'code', 'guest'])
                          && lqRoom(pin).meta.guest == true
                          && lqRoom(pin).meta.status != 'ended'
                          && lqRoom(pin).meta.locked != true);
        allow update: if lqIsRoomHost(pin)
                      || (request.auth != null
                          && request.auth.uid == uid
                          && resource.data.kicked == false
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen', 'name', 'syncAt', 'rtt', 'lag', 'dev'])
                          && (!('rtt' in request.resource.data) || request.resource.data.rtt is number)
                          && (!('lag' in request.resource.data) || request.resource.data.lag is number)
                          && (!('dev' in request.resource.data) || (request.resource.data.dev is string && request.resource.data.dev.size() <= 40)));
        allow delete: if lqIsRoomHost(pin);
      }
      match /answers/{aid} {
        allow create: if lqAnswerOk(pin, aid);
        allow get, list: if lqIsRoomHost(pin)
                         || (request.auth != null && resource.data.uid == request.auth.uid);
        allow update: if false;
        allow delete: if isAdmin();
      }
      match /powerups/{pid} {
        allow create: if lqPowerOk(pin, pid);
        allow get, list: if lqIsRoomHost(pin)
                         || (request.auth != null && resource.data.uid == request.auth.uid);
        allow update: if false;
        allow delete: if isAdmin();
      }
      match /private/{uid} {
        allow get: if (request.auth != null && request.auth.uid == uid) || lqIsRoomHost(pin);
        allow list: if lqIsRoomHost(pin);
        allow create, update: if lqIsRoomHost(pin);
        allow delete: if isAdmin();
      }
      match /host/{docId} {
        allow read, create, update: if lqIsRoomHost(pin);
        allow delete: if isAdmin();
      }
    }

    match /liveQuizBoard/{docId} {
      allow read: if request.auth != null;
      allow create, update: if isLqHost();
      allow delete: if isAdmin();
    }

    match /liveQuizHistory/{histId} {
      allow get, list: if isAdmin()
                       || (isLqHost() && resource.data.hostUid == request.auth.uid);
      allow create: if isLqHost() && request.resource.data.hostUid == request.auth.uid;
      allow update: if isAdmin()
                    || (isLqHost()
                        && resource.data.hostUid == request.auth.uid
                        && request.resource.data.hostUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /liveQuizSets/{setId} {
      allow get, list: if isAdmin()
                       || (isLqHost() && resource.data.ownerUid == request.auth.uid);
      allow create: if isLqHost() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAdmin()
                            || (isLqHost() && resource.data.ownerUid == request.auth.uid);
    }

    // 預設拒絕所有其他存取(安全防護)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
